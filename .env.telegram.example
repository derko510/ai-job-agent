# Optional Telegram alerts. Copy to .env.telegram and fill in (never share this file):
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
# 2. Send your new bot any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
# 3. Set notifications.telegram = true in profile.json.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
